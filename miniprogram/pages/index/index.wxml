<view class="app">

  <!-- 沉浸式自定义导航：只有标题；转发由右上角「…」菜单触发 -->
  <view class="nav {{navSolid ? 'is-solid' : ''}}" style="padding-top:{{statusBarHeight}}px">
    <view class="nav-inner">
      <text class="nav-title">朋友圈</text>
    </view>
  </view>

  <!-- 封面：点头像或昵称 → 资料页 -->
  <view class="cover" style="height:{{coverHeight}}px">
    <image class="cover-img" src="{{coverUrl}}" mode="{{coverMode}}"></image>
    <view class="cover-mask"></view>
    <view class="cover-user" bindtap="openProfile">
      <text class="cover-name">{{profile.name}}</text>
      <view class="cover-avatar-wrap">
        <image wx:if="{{profile.avatar}}" class="cover-avatar" src="{{profile.avatar}}" mode="aspectFill" binderror="onAvatarError"></image>
        <view wx:else class="cover-avatar cover-avatar-fallback"></view>
      </view>
    </view>
  </view>

  <!-- 信息流：点头像或昵称 → 该条详情页；正文与媒体不可点 -->
  <view class="feed">

    <block wx:if="{{viewState === 'loading'}}">
      <view class="skeleton" wx:for="{{skeletons}}" wx:key="*this">
        <view class="sk sk-avatar"></view>
        <view class="sk-main">
          <view class="sk sk-line" style="width:30%"></view>
          <view class="sk sk-line" style="width:88%"></view>
          <view class="sk sk-line" style="width:64%"></view>
          <view class="sk sk-block"></view>
        </view>
      </view>
    </block>

    <view class="state" wx:elif="{{viewState === 'empty'}}">
      <text class="state-text">还没有内容</text>
    </view>

    <view class="state" wx:elif="{{viewState === 'error'}}">
      <text class="state-text">加载失败，请检查网络后重试</text>
      <view class="retry" bindtap="onRetry">重新加载</view>
    </view>

    <block wx:else>
      <view class="moment {{mIndex > 0 ? 'has-line' : ''}}"
            wx:for="{{moments}}" wx:for-index="mIndex" wx:key="uid">

        <view class="avatar-wrap" data-uid="{{item.uid}}" bindtap="openDetail">
          <image wx:if="{{profile.avatar}}" class="moment-avatar" src="{{profile.avatar}}" mode="aspectFill" binderror="onAvatarError"></image>
          <view wx:else class="moment-avatar moment-avatar-fallback"></view>
        </view>

        <view class="moment-body">
          <text class="moment-name" data-uid="{{item.uid}}" bindtap="openDetail">{{profile.name}}</text>

          <view wx:if="{{item.content}}" class="moment-text {{item.folded ? 'is-folded' : ''}}"><text>{{item.content}}</text></view>
          <view wx:if="{{item.needFold}}" class="fold-btn" data-index="{{mIndex}}" bindtap="toggleFold">{{item.folded ? '全文' : '收起'}}</view>

          <!-- 九宫格：1 图自然比例 / 2、4 图两列 / 其余三列，最多显示 9 张 -->
          <view wx:if="{{item.images.length}}" class="grid grid-{{item.gridType}}" style="{{item.gridStyle}}">
            <view class="cell"
                  wx:for="{{item.images}}" wx:for-item="img" wx:for-index="imgIndex" wx:key="origin"
                  style="{{item.gridType === 1 ? item.singleStyle : item.cellStyle}}"
                  data-mid="{{mIndex}}" data-index="{{imgIndex}}" bindtap="onPreviewImage">
              <image class="cell-img" src="{{img.thumb}}"
                     mode="{{item.gridType === 1 ? 'widthFix' : 'aspectFill'}}"
                     lazy-load="true"
                     data-mid="{{mIndex}}" data-index="{{imgIndex}}" binderror="onImageError"></image>
              <view wx:if="{{img.more}}" class="cell-more"><text>+{{img.moreCount}}</text></view>
            </view>
          </view>

          <!-- 视频 / 音频 / 其它附件：内容展示，不提供跳转或下载入口 -->
          <view wx:for="{{item.extras}}" wx:for-item="extra" wx:key="url" class="extra">
            <video wx:if="{{extra.kind === 'video'}}" class="extra-video" src="{{extra.url}}"
                   controls="{{true}}" object-fit="contain" show-center-play-btn="{{true}}"
                   enable-play-gesture="{{false}}"></video>

            <view wx:elif="{{extra.kind === 'audio'}}" class="extra-card" data-url="{{extra.url}}" bindtap="onToggleAudio">
              <view class="audio-play"><text class="audio-icon">{{playingKey === extra.url ? 'Ⅱ' : '▶'}}</text></view>
              <view class="extra-main">
                <text class="extra-name">{{extra.name}}</text>
                <text wx:if="{{extra.sizeText}}" class="extra-size">{{extra.sizeText}}</text>
              </view>
            </view>

            <view wx:else class="extra-card extra-card-static">
              <text class="extra-file-icon">▤</text>
              <view class="extra-main">
                <text class="extra-name">{{extra.name}}</text>
                <text wx:if="{{extra.sizeText}}" class="extra-size">{{extra.sizeText}}</text>
              </view>
            </view>
          </view>

          <view class="meta"><text class="moment-time">{{item.timeText}}</text></view>
        </view>
      </view>

      <view class="pager">
        <view wx:if="{{loadingMore}}" class="spinner"></view>
        <view wx:elif="{{loadError}}" class="pager-btn" bindtap="onRetryMore">加载失败，点击重试</view>
        <view wx:elif="{{!done}}" class="pager-btn" bindtap="loadMore">加载更多</view>
        <text wx:elif="{{moments.length}}" class="feed-end">没有更多了</text>
      </view>
    </block>

  </view>

  <!-- 回到顶部：长列表向下滚动后淡入，点击平滑回顶 -->
  <view class="top-btn {{showTop ? 'is-visible' : ''}}" bindtap="onBackTop">
    <view class="top-ico">
      <view class="top-ico-bar"></view>
      <view class="top-ico-chevron"></view>
    </view>
  </view>
</view>
